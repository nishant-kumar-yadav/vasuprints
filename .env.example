# Copy to .env.local for development. Never commit real values.
# Production must set every secret below; the app refuses to start without them.

# ── Site ──────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
# static = content files in src/content (no database); mongo = admin-editable catalog
CATALOG_SOURCE=static
# on = quote form saves leads, uploads files and sends emails; off = WhatsApp/email hand-off only
QUOTE_BACKEND=off
# Set to true only behind a reverse proxy (Nginx) that sets X-Forwarded-For
TRUST_PROXY=false
# true lets `pnpm build && pnpm start` run on localhost without SMTP/Turnstile/admin secrets
LOCAL_PREVIEW=false

# ── Database ──────────────────────────────────────────────────────────
# docker compose:  mongodb://127.0.0.1:27017/vasuprint
MONGODB_URI=

# ── Storage (outside the web root; back these up) ─────────────────────
UPLOAD_DIR=./storage/uploads
MEDIA_DIR=./storage/media
# Without SMTP (dev only) emails are written here as .eml files
MAIL_DIR=./storage/mail

# ── Email ─────────────────────────────────────────────────────────────
# Mailpit (docker compose): SMTP_HOST=127.0.0.1 SMTP_PORT=1025, any user/pass
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VasuPrint <quotes@vasuprint.com>"
QUOTE_NOTIFY_TO=

# ── Spam protection ───────────────────────────────────────────────────
# openssl rand -hex 32
IP_HASH_SALT=
# Cloudflare Turnstile. Test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Admin ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=
# pnpm admin:hash  (paste the printed line as-is; each $ is escaped as \$)
ADMIN_PASSWORD_HASH=
# openssl rand -base64 48
SESSION_SECRET=
# Bump to sign out every admin session
SESSION_VERSION=1

# ── Product images (optional; without these, images are stored in MEDIA_DIR) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Analytics (optional) ──────────────────────────────────────────────
# GA4 measurement id, e.g. G-XXXXXXX. Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=
